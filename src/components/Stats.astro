---
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  stats?: { value: string; label: string }[];
}
const { lang, stats: statsProp } = Astro.props;
const dict = t[lang];

const stats = statsProp ?? [
  { value: '40+', label: dict.statsYears },
  { value: '300+', label: dict.statsInstructors },
  { value: '60+', label: dict.statsCosmonauts },
  { value: '10 000+', label: dict.statsDives },
];
---

<div class="grid grid-4 stats">
  {stats.map((s) => (
    <div class="stat card">
      <div class="value">{s.value}</div>
      <div class="muted label">{s.label}</div>
    </div>
  ))}
</div>

<style>
  .stat { text-align: center; padding: 1.25rem 0.75rem; }
  .value { font-size: 2rem; font-weight: 800; color: var(--accent); }
  .label { font-size: 0.88rem; }
</style>

---
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t[lang];

const timeline =
  lang === 'ru'
    ? [
        { period: '1970-е', text: 'Инженерное образование, начало работы в области водолазной подготовки.' },
        { period: '1980-е — 1990-е', text: 'Гидролаборатория Центра подготовки космонавтов им. Ю. А. Гагарина, Звёздный городок: старший инженер-испытатель, начальник лаборатории. Подготовка космонавтов и астронавтов (в том числе NASA) к внекорабельной деятельности в условиях гидроневесомости.' },
        { period: '1990-е', text: 'Переход в рекреационный дайвинг. Сертификация PADI, работа инструктором.' },
        { period: '2000-е', text: 'Курс-директор PADI. Проведение программ IDC в России, Египте и других странах.' },
        { period: 'Сегодня', text: 'Платиновый курс-директор PADI. Сотни подготовленных инструкторов, семинары и программы профессиональной подготовки.' },
      ]
    : [
        { period: '1970s', text: 'Engineering education, first steps in diving training.' },
        { period: '1980s — 1990s', text: 'Hydro laboratory of the Gagarin Cosmonaut Training Center, Star City: senior test engineer, laboratory head. Trained cosmonauts and astronauts (including NASA crews) for spacewalks in simulated weightlessness underwater.' },
        { period: '1990s', text: 'Transition to recreational diving. PADI certification, work as an instructor.' },
        { period: '2000s', text: 'PADI Course Director. IDC programs in Russia, Egypt and other countries.' },
        { period: 'Today', text: 'PADI Platinum Course Director. Hundreds of instructors trained, seminars and professional development programs.' },
      ];

const title = lang === 'ru' ? 'Биография' : 'Biography';
const intro =
  lang === 'ru'
    ? 'Путь Александра Шурубкина уникален: от подготовки космонавтов к выходам в открытый космос — к подготовке профессиональных инструкторов дайвинга. Обе профессии объединяет одно: умение научить человека уверенно работать под водой.'
    : "Alexander Shurubkin's path is unique: from preparing cosmonauts for spacewalks to educating professional diving instructors. Both careers share one essence: teaching people to work confidently underwater.";
---

<Base title={title + ' — ' + dict.siteName} description={intro} lang={lang} currentPath="/bio">
  <section>
    <div class="container">
      <h1>{title}</h1>
      <p class="muted intro">{intro}</p>

      <div class="timeline">
        {timeline.map((item) => (
          <div class="timeline-item">
            <div class="period accent">{item.period}</div>
            <div class="card">{item.text}</div>
          </div>
        ))}
      </div>

      <p class="muted note">
        {lang === 'ru'
          ? 'Раздел будет дополнен фотографиями и документами из личного архива.'
          : 'This section will be extended with photos and documents from the personal archive.'}
      </p>
    </div>
  </section>
</Base>

<style>
  .intro { max-width: 680px; margin: 1rem 0 2.5rem; }
  .timeline { display: flex; flex-direction: column; gap: 1.25rem; max-width: 760px; }
  .timeline-item { display: grid; grid-template-columns: 140px 1fr; gap: 1rem; align-items: start; }
  .period { font-weight: 700; padding-top: 1.4rem; }
  .note { margin-top: 2.5rem; font-size: 0.9rem; }
  @media (max-width: 600px) {
    .timeline-item { grid-template-columns: 1fr; gap: 0.3rem; }
    .period { padding-top: 0; }
  }
</style>

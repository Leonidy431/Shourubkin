---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t[lang];

const entry = await getEntry('pages', `bio-${lang}`);
if (!entry) throw new Error(`Missing content: pages/bio-${lang}`);
const { Content } = await render(entry);
const { title, intro, timeline = [] } = entry.data;
---

<Base title={title + ' — ' + dict.siteName} description={intro ?? ''} lang={lang} currentPath="/bio">
  <section>
    <div class="container">
      <h1>{title}</h1>
      {intro && <p class="muted intro">{intro}</p>}

      <div class="timeline">
        {timeline.map((item) => (
          <div class="timeline-item">
            <div class="period accent">{item.period}</div>
            <div class="card">{item.text}</div>
          </div>
        ))}
      </div>

      <div class="prose">
        <Content />
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { max-width: 680px; margin: 1rem 0 2.5rem; }
  .timeline { display: flex; flex-direction: column; gap: 1.25rem; max-width: 760px; }
  .timeline-item { display: grid; grid-template-columns: 140px 1fr; gap: 1rem; align-items: start; }
  .period { font-weight: 700; padding-top: 1.4rem; }
  .prose { max-width: 720px; margin-top: 2.5rem; display: flex; flex-direction: column; gap: 1rem; }
  @media (max-width: 600px) {
    .timeline-item { grid-template-columns: 1fr; gap: 0.3rem; }
    .period { padding-top: 0; }
  }
</style>

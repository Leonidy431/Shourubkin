---
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t[lang];

const title = lang === 'ru' ? 'Контакты' : 'Contacts';
const intro =
  lang === 'ru'
    ? 'Для записи на курсы, вопросов о семинарах и сотрудничества свяжитесь любым удобным способом.'
    : 'To apply for courses, ask about seminars or discuss cooperation, get in touch via any convenient channel.';

const channels = [
  { label: 'Telegram', href: 'https://t.me/username_here', note: lang === 'ru' ? 'самый быстрый способ' : 'fastest way' },
  { label: 'WhatsApp', href: 'https://wa.me/70000000000', note: lang === 'ru' ? 'для международных запросов' : 'for international enquiries' },
  { label: 'Email', href: 'mailto:info@example.com', note: 'info@example.com' },
];
---

<Base title={title + ' — ' + dict.siteName} description={intro} lang={lang} currentPath="/contacts">
  <section>
    <div class="container">
      <h1>{title}</h1>
      <p class="muted intro">{intro}</p>

      <div class="grid grid-3">
        {channels.map((c) => (
          <a class="card channel" href={c.href} target="_blank" rel="noopener">
            <h3>{c.label}</h3>
            <p class="muted">{c.note}</p>
          </a>
        ))}
      </div>

      <p class="muted note">
        {lang === 'ru'
          ? 'Контактные данные будут обновлены — актуальные ссылки на Telegram, WhatsApp и email добавит владелец сайта через админ-панель.'
          : 'Contact details are placeholders — real Telegram, WhatsApp and email links will be added by the site owner.'}
      </p>
    </div>
  </section>
</Base>

<style>
  .intro { max-width: 680px; margin: 1rem 0 2rem; }
  .channel { color: var(--text); transition: border-color 0.15s ease; }
  .channel:hover { text-decoration: none; border-color: var(--accent); }
  .note { margin-top: 2rem; font-size: 0.9rem; }
</style>

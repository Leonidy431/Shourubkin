---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, type Lang, localizePath } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const entry = await getEntry('pages', `courses-${lang}`);
if (!entry) throw new Error(`Missing content: pages/courses-${lang}`);
const { Content } = await render(entry);
const { title, intro, pathway = [], courses = [] } = entry.data;
---

<Base title={title + ' — ' + dict.siteName} description={intro ?? ''} lang={lang} currentPath="/courses">
  <section>
    <div class="container">
      <h1>{title}</h1>
      {intro && <p class="muted intro">{intro}</p>}

      <h2>{lang === 'ru' ? 'Путь профессионала PADI' : 'The PADI Pro pathway'}</h2>
      <div class="pathway">
        {pathway.map((step, i) => (
          <>
            <span class="tag step">{step}</span>
            {i < pathway.length - 1 && <span class="muted">→</span>}
          </>
        ))}
      </div>

      <div class="grid grid-2" style="margin-top:2rem">
        {courses.map((c) => (
          <div class="card">
            <h3>{c.name}</h3>
            <p class="muted">{c.text}</p>
          </div>
        ))}
      </div>

      <div class="prose">
        <Content />
      </div>

      <div class="cta-row">
        <a href={base + localizePath('/seminars', lang)} class="btn">{dict.allSeminars}</a>
        <a href={base + localizePath('/contacts', lang)} class="btn secondary">{dict.ctaContact}</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { max-width: 680px; margin: 1rem 0 2.5rem; }
  .pathway { display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: center; }
  .step { color: var(--text); }
  .prose { max-width: 720px; margin-top: 2.5rem; display: flex; flex-direction: column; gap: 1rem; }
  .cta-row { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 2rem; }
</style>

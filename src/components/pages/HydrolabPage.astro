---
import { getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { t, type Lang } from '../../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const dict = t[lang];

const entry = await getEntry('pages', `hydrolab-${lang}`);
if (!entry) throw new Error(`Missing content: pages/hydrolab-${lang}`);
const { Content } = await render(entry);
const { title, intro, facts = [], note } = entry.data;
---

<Base title={title + ' — ' + dict.siteName} description={intro ?? ''} lang={lang} currentPath="/hydrolab">
  <section>
    <div class="container">
      <h1>{title}</h1>
      {intro && <p class="muted intro">{intro}</p>}

      <div class="grid grid-4 facts">
        {facts.map((f) => (
          <div class="card fact">
            <div class="value accent">{f.value}</div>
            <div class="muted">{f.label}</div>
          </div>
        ))}
      </div>

      <div class="prose">
        <Content />
      </div>

      {note && <p class="muted note">{note}</p>}
    </div>
  </section>
</Base>

<style>
  .intro { max-width: 680px; margin: 1rem 0 2rem; }
  .facts { margin-bottom: 2.5rem; }
  .fact { text-align: center; padding: 1.25rem 0.75rem; }
  .value { font-size: 1.6rem; font-weight: 800; }
  .prose { max-width: 720px; display: flex; flex-direction: column; gap: 1rem; }
  .note { margin-top: 2.5rem; font-size: 0.9rem; }
</style>

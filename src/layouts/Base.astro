---
import '../styles/global.css';
import { t, type Lang, localizePath } from '../i18n';

interface Props {
  title: string;
  description?: string;
  lang?: Lang;
  currentPath?: string;
}

const { title, description = '', lang = 'ru', currentPath = '/' } = Astro.props;
const dict = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const navItems = [
  { href: '/', label: dict.nav.home },
  { href: '/bio', label: dict.nav.bio },
  { href: '/hydrolab', label: dict.nav.hydrolab },
  { href: '/courses', label: dict.nav.courses },
  { href: '/seminars', label: dict.nav.seminars },
  { href: '/news', label: dict.nav.news },
  { href: '/contacts', label: dict.nav.contacts },
];

const link = (p: string) => base + localizePath(p, lang);
const otherLang: Lang = lang === 'ru' ? 'en' : 'ru';
const otherLangHref = base + localizePath(currentPath, otherLang);

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: lang === 'ru' ? 'Александр Дмитриевич Шурубкин' : 'Alexander Shurubkin',
  jobTitle: 'PADI Course Director',
  description: dict.heroSubtitle,
  knowsAbout: ['Scuba diving instruction', 'PADI IDC', 'Neutral buoyancy training', 'Cosmonaut training'],
};
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href={base + '/favicon.svg'} type="image/svg+xml" />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <header class="site-header">
      <div class="container header-inner">
        <a href={link('/')} class="brand">{dict.siteName}</a>
        <nav class="site-nav">
          {navItems.map((item) => <a href={link(item.href)}>{item.label}</a>)}
          <a href={otherLangHref} class="lang-switch">{otherLang.toUpperCase()}</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p class="muted">© {new Date().getFullYear()} {dict.siteName}. {dict.footerRights}</p>
      </div>
    </footer>

    <style>
      .site-header {
        position: sticky;
        top: 0;
        z-index: 10;
        background: rgba(6, 18, 31, 0.92);
        backdrop-filter: blur(8px);
        border-bottom: 1px solid var(--border);
      }
      .header-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 0.8rem;
        padding-bottom: 0.8rem;
        flex-wrap: wrap;
      }
      .brand { font-weight: 700; color: var(--text); font-size: 1.05rem; }
      .brand:hover { text-decoration: none; color: var(--accent); }
      .site-nav { display: flex; gap: 1rem; flex-wrap: wrap; align-items: center; }
      .site-nav a { color: var(--text-dim); font-size: 0.92rem; }
      .site-nav a:hover { color: var(--accent); text-decoration: none; }
      .lang-switch {
        border: 1px solid var(--border);
        border-radius: 6px;
        padding: 0.15rem 0.55rem;
        font-weight: 600;
      }
      .site-footer { border-top: 1px solid var(--border); padding: 2rem 0; margin-top: 3rem; }
    </style>
  </body>
</html>
